let universities=[];let universitiesLoaded=!1;let uniLoadStarted=!1;function loadAllUniversities(){try{const cached=sessionStorage.getItem('tcf_unis_cache');if(cached){const raw=JSON.parse(cached);universities=raw.map(u=>({id:u.id||u.institute_id,name:u.name||u.institute_name||u.title||'',slug:u.slug||(u.name&&u.name.toLowerCase().replace(/\s+/g,'-')),city:u.city||'',country:u.country||'',region:u.region||'',state:u.state||u.province||''}));universitiesLoaded=!0;return Promise.resolve()}}catch(e){}
