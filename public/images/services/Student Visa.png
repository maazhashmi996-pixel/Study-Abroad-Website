function initHomepage(){if(!location.pathname.endsWith('/'))return;document.querySelectorAll('form.elementor-form select').forEach(select=>{if(select.dataset.homeDone)return;if(select.options.length===0)return;const group=select.closest('.elementor-field-group');const label=normalize(group?.querySelector('label')?.innerText);const form=select.closest('form');if(label.includes('study destination')){rebuild(select,DATA.desire_country_list,'Preferred Study Destination');select.dataset.homeDone="1"}else if(label.includes('study level')){rebuild(select,DATA.qualification_level_list,'Preferred Study Level');select.dataset.homeDone="1"}else if(label.includes('counselling')){rebuild(select,DATA.counselling_modes||[{name:'Online'},{name:'On Campus'},{name:'Phone'}],'Preferred Mode of Counselling');select.dataset.homeDone="1"}else if(label.includes('nearest')){rebuild(select,Object.keys(DATA.branches).map(c=>({name:c})),'Select City');function cityHandler(){const city=select.value;if(!DATA.branches[city])return;if(form)form.dataset.selectedCity=city;select.innerHTML='<option value="" disabled selected>Select Branch</option>';select.insertAdjacentHTML('beforeend',`<option value="__change_city__">— Change City —</option>`);DATA.branches[city].forEach(b=>{select.insertAdjacentHTML('beforeend',`<option value="${b.name}">${b.branch}</option>`)});select.removeEventListener('change',cityHandler);function changeCityHandler(){if(select.value!=='__change_city__')return;if(form)form.dataset.selectedCity='';rebuild(select,Object.keys(DATA.branches).map(c=>({name:c})),'Select City');select.removeEventListener('change',changeCityHandler);select.addEventListener('change',cityHandler)}
select.addEventListener('change',changeCityHandler)}
select.addEventListener('change',cityHandler);select.dataset.homeDone="1"}})}
function initOtherForms(){if(location.pathname.endsWith('/times/'))return;document.querySelectorAll('form.elementor-form').forEach(form=>{if(form.dataset.overrideDone)return;form.dataset.overrideDone="1";let citySelect=null;let officeSelect=null;form.querySelectorAll('.elementor-field-group').forEach(group=>{const label=normalize(group.querySelector('label')?.innerText);if(label==='select city')citySelect=group.querySelector('select');if(label==='nearest office')officeSelect=group.querySelector('select');});form.querySelectorAll('.elementor-field-group').forEach(group=>{const label=normalize(group.querySelector('label')?.innerText);const select=group.querySelector('select');if(!select||select.dataset.rebuilt)return;if(label==='preferred country')rebuild(select,DATA.desire_country_list,'Preferred Country');if(label==='preferred study level')rebuild(select,DATA.qualification_level_list,'Preferred Study Level');if(label==='field of interest')rebuild(select,DATA.course_pref_list,'Field of Interest');});if(!citySelect||!officeSelect)return;rebuild(citySelect,Object.keys(DATA.branches).map(c=>({name:c})),'Select City');officeSelect.innerHTML='<option value="" disabled selected>Nearest Office*</option>';officeSelect.disabled=!0;citySelect.addEventListener('change',()=>{const city=citySelect.value;form.dataset.selectedCity=city;officeSelect.innerHTML='<option value="" disabled selected>Nearest Office*</option>';if(!DATA.branches[city]){officeSelect.disabled=!0;return}
