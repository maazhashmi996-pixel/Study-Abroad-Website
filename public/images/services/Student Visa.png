function updateDegreeParentState(parentId){const g=groups[parentId];if(!g)return;const total=g.items.length;const checked=g.items.filter(it=>it.elCheckbox.checked).length;if(checked===0){g.elParentCheckbox.checked=!1;g.elParentCheckbox.indeterminate=!1;g.selectedAllByParent=!1}else if(checked===total){g.elParentCheckbox.checked=!0;g.elParentCheckbox.indeterminate=!1;g.selectedAllByParent=!0}else{g.elParentCheckbox.checked=!1;g.elParentCheckbox.indeterminate=!0;g.selectedAllByParent=!1}
