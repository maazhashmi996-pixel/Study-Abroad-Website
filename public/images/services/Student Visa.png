ding:40px;background:#fff;border-radius:12px;box-shadow:0 6px 20px rgb(12 18 32 / .08);position:relative;font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial}.tcf-tabs{display:flex;gap:12px;margin-bottom:18px;border-bottom:1px solid #eee;padding-bottom:8px}.tcf-tab{padding:10px 16px;cursor:pointer;border-radius:8px 8px 0 0;color:#444}.tcf-tab.active{color:#5a2be6;border-bottom:3px solid rgb(90 43 230 / .15);font-weight:600}.tcf-row{display:flex;gap:14px;align-items:center}.tcf-input,.tcf-select{flex:1;padding:14px 16px;border-radius:8px;border:1px solid #e4e7ef;background:#fff;min-width:160px;font-size:14px}.tcf-search-btn{position:absolute;left:50%;transform:translateX(-50%);bottom:-22px;background:#fbb01b;color:#fff;border:none;padding:12px 28px;border-radius:26px;box-shadow:0 6px 18px rgb(62 139 255 / .25);cursor:pointer;font-weight:600}.tcf-suggest-list{position:absolute;z-index:999;background:#fff;border:1px solid #eee;width:100%;max-height:220px;overflow:auto;border-radius:8px;margin-top:6px;box-shadow:0 8px 24px rgb(12 18 32 / .08)}.tcf-suggest-item{padding:8px 12px;cursor:pointer}.tcf-suggest-item:hover{background:#f6f8ff}.tcf-field-wrap{position:relative;flex:1}.tcf-multi-wrap{position:relative;flex:1}.tcf-multi-input{min-height:46px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:8px 12px;border-radius:8px;border:1px solid #e4e7ef;background:#fff;cursor:pointer}.tcf-multi-input .placeholder{color:#9aa3b2;font-size:14px;padding:6px 8px}.tcf-chip{display:inline-flex;align-items:center;gap:8px;background:#f3f6ff;color:#163b7a;padding:6px 8px;border-radius:999px;font-size:13px}.tcf-chip .remove{width:18px;height:18px;line-height:18px;text-align:center;border-radius:50%;background:#fff0;color:#163b7a;cursor:pointer;font-weight:700}.tcf-chip.parent{background:#fff1d8;color:#8a5b00}.tcf-multi-arrow{margin-left:auto;color:#9aa3b2;padding-left:8px}.tcf-multi-dropdown{position:absolute;top:calc(100% + 8px);left:0;right:0;z-index:999;background:#fff;border-radius:8px;border:1px solid #eee;box-shadow:0 8px 28px rgb(12 18 32 / .08);max-height:420px;overflow:auto;display:none;padding:8px}.tcf-multi-search{display:flex;gap:8px;padding:8px;border-bottom:1px solid #f4f6fb}.tcf-multi-search input{flex:1;padding:8px 10px;border-radius:6px;border:1px solid #e6e9f0;font-size:13px}.tcf-multi-item{display:flex;align-items:center;gap:10px;padding:8px 10px;cursor:pointer;border-radius:6px}.tcf-multi-item:hover{background:#f6f8ff}.tcf-degree-wrap{position:relative;flex:1}.tcf-degree-input{min-height:46px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:8px 12px;border-radius:8px;border:1px solid #e4e7ef;background:#fff;cursor:pointer}.tcf-degree-dropdown{position:absolute;top:calc(100% + 8px);left:0;right:0;z-index:999;background:#fff;border-radius:8px;border:1px solid #eee;box-shadow:0 8px 28px rgb(12 18 32 / .08);max-height:320px;overflow:auto;display:none;padding:8px 0}.tcf-degree-parent{padding:10px 14px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;border-bottom:1px solid #f4f6fb}.tcf-degree-parent .left{display:flex;align-items:center;gap:10px}.tcf-degree-children{display:none;padding:8px 18px 12px 40px}.tcf-degree-child{display:flex;align-items:center;gap:10px;padding:6px 0}.tcf-degree-parent .chevron{color:#9aa3b2;transition:transform .18s ease}.tcf-degree-parent.open .chevron{transform:rotate(90deg)}.tcf-uni-row:hover{background:#f6f8ff}.tcf-uni-results{position:absolute;top:calc(100% + 8px);left:0;right:0;z-index:999;background:#fff;border:1px solid #eee;border-radius:8px;max-height:350px;overflow-y:auto;display:none;box-shadow:0 8px 24px rgb(12 18 32 / .08)}.tcf-uni-row{display:flex;align-items:center;gap:12px;padding:12px 14px;cursor:pointer;border-bottom:1px solid #f4f6fb;transition:background 0.2s}.tcf-uni-row:last-child{border-bottom:none}.tcf-uni-logo{width:40px;height:40px;object-fit:contain;border-radius:4px;flex-shrink:0}.tcf-uni-info{flex:1;min-width:0}.tcf-uni-name{font-weight:500;color:#1a1a1a;font-size:14px;margin-bottom:2px}.tcf-uni-location{font-size:12px;color:#666}.tcf-loading-msg,.tcf-loading-progress{padding:16px;text-align:center;color:#666;font-size:13px}.tcf-error-msg{padding:16px;text-align:center;color:#d32f2f;font-size:13px}.tcf-spinner{display:inline-block;width:16px;height:16px;border:2px solid #f3f3f3;border-top:2px solid #5a2be6;border-radius:50%;animation:spin 1s linear infinite;margin-right:8px;vertical-align:middle}@keyframes spin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}@media(max-width:920px){.tcf-row{flex-direction:column}.tcf-multi-input,.tcf-degree-input{width:100%}}</style><link data-optimized="1" data-asynced="1" as="style" onload="this.onload=null;this.rel='stylesheet'" rel="stylesheet" id="wp-review-slider-pro-public_combine-css" href="Student%20Visa_files/7369549bfb36d85e41631b88f92db264_WuhY.css" media="all"><noscript><link data-optimized="1" rel='stylesheet' href='https://timesconsultant.com/wp-content/litespeed/css/7369549bfb36d85e41631b88f92db264.css?ver=84668' media='all' /></noscript><link data-optimized="1" data-asynced="1" as="style" onload="this.onload=null;this.rel='stylesheet'" rel="stylesheet" id="grw-public-main-css-css" href="Student%20Visa_files/361c9234a5964293a396ae99d7344571_WuhY.css" media="all"><noscript><link data-optimized="1" rel='stylesheet' href='https://timesconsultant.com/wp-content/litespeed/css/361c9234a5964293a396ae99d7344571.css?ver=44571' media='all' /></noscript><link data-optimized="1" data-asynced="1" as="style" onload="this.onload=null;this.rel='stylesheet'" rel="stylesheet" id="blocksy-fonts-font-source-google-css" href="Student%20Visa_files/27c9744316ddc4c924ccb0080e004e60_WuhY.css" media="all"><noscript><link data-optimized="1" rel='stylesheet' href='https://timesconsultant.com/wp-content/litespeed/css/27c9744316ddc4c924ccb0080e004e60.css?ver=04e60' media='all' /></noscript><link data-optimized="1" data-asynce