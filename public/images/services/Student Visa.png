function resolveFormType(form){const postId=form.querySelector('input[name="post_id"]')?.value||'';const formId=form.querySelector('input[name="form_id"]')?.value||'';const slug=location.pathname.replace(/^\/|\/$/g,'').toLowerCase();const title=document.title.toLowerCase();const isPopup=!!form.closest('.elementor-popup-modal, .dialog-widget, .dialog-message, [data-elementor-type="popup"]');console.log('🔍 resolveFormType debug:',{slug,title,postId,formId,isPopup});if(isPopup&&FORM_TYPE_BY_SLUG[slug]){return FORM_TYPE_BY_SLUG[slug]}
if(FORM_TYPE_BY_FORM_ID[formId]){return FORM_TYPE_BY_FORM_ID[formId]}
if(FORM_TYPE_BY_POST_ID[postId]){return FORM_TYPE_BY_POST_ID[postId]}
const slugSegments=slug.split('/');const lastSegment=slugSegments[slugSegments.length-1]||'';for(const key in FORM_TYPE_BY_TITLE){if(title.includes(key)||slug===key||lastSegment===key){return FORM_TYPE_BY_TITLE[key]}}
if(FORM_TYPE_BY_SLUG[slug]){return isPopup?FORM_TYPE_BY_SLUG[slug]:FORM_TYPE_BY_SLUG[slug].replace(/ - Modal$/,'')}
return'TCO Generic Form'}
function showError(field,msg){field.classList.add('crm-field-error');let wrapper=field.closest('.elementor-field-group')||field.parentNode;const existing=wrapper.querySelector('.crm-error-msg');if(existing)existing.remove();const span=document.createElement('span');span.className='crm-error-msg';span.textContent=msg;wrapper.appendChild(span)}
function clearError(field){field.classList.remove('crm-field-error');let wrapper=field.closest('.elementor-field-group')||field.parentNode;const existing=wrapper.querySelector('.crm-error-msg');if(existing)existing.remove();}
function clearAllErrors(form){form.querySelectorAll('.crm-field-error').forEach(f=>f.classList.remove('crm-field-error'));form.querySelectorAll('.crm-error-msg').forEach(el=>el.remove())}
function showFormNotice(form,msg){let notice=form.querySelector('.crm-form-notice');if(!notice){notice=document.createElement('div');notice.className='crm-form-notice';notice.style.cssText='margin-top:10px;color:#c0392b;font-size:14px;';const submitBtn=form.querySelector('[type="submit"]');if(submitBtn&&submitBtn.parentNode){submitBtn.parentNode.appendChild(notice)}else{form.appendChild(notice)}}
notice.textContent=msg}
function clearFormNotice(form){const notice=form.querySelector('.crm-form-notice');if(notice)notice.remove();}
document.addEventListener('input',e=>{if(e.target.classList.contains('crm-field-error')){const val=(e.target.value||'').trim();if(val)clearError(e.target);}});document.addEventListener('change',e=>{if(e.target.classList.contains('crm-field-error')){if(e.target.tagName==='SELECT'){if(!isPlaceholderValue(e.target))clearError(e.target);}else{const val=(e.target.value||'').trim();if(val)clearError(e.target);}}});function getFieldText(el){const group=el.closest('.elementor-field-group');const label=group?.querySelector('.elementor-field-label')?.textContent||'';const placeholder=el.getAttribute('placeholder')||'';const name=el.getAttribute('name')||'';const id=el.getAttribute('id')||'';const firstOption=el.tagName==='SELECT'?(el.options[0]?.textContent||''):'';return normalize([label,placeholder,name,id,firstOption].join(' | '))}
function isPreferredCountryField(el){return getFieldText(el).includes('preferred country')}
function isStudyLevelField(el){const t=getFieldText(el);return t.includes('preferred study level')||t.includes('study level')}
function isFieldOfInterestField(el){const t=getFieldText(el);return t.includes('field of interest')||t.includes('discipline')}
function isLanguageTestField(el){const t=getFieldText(el);return t.includes('language test')||t.includes('test you want')||t.includes('select test')}
function isPreferredModeField(el){const t=getFieldText(el);return t.includes('preferred mode')||t.includes('mode of counselling')||t.includes('mode of counseling')}
function isCityField(el){const t=getFieldText(el);return t.includes('select city')||t.includes('city')}
function isNearestOfficeField(el){const t=getFieldText(el);return t.includes('nearest office')}
function isTimeField(el){const t=getFieldText(el);return t.includes('time')||t.includes('preferred time')||t.includes('counselling time')||t.includes('counseling time')||t.includes('select your slot')||t.includes('your slot')}
function isPlaceholderValue(select){const val=(select.value||'').trim();const txt=normalize(select.options[select.selectedIndex]?.textContent||'');if(!val)return!0;const bad=['select','select city','nearest office','nearest office*','preferred country','preferred study level','field of interest','preferred mode of counselling','preferred mode of counseling','preferred mode','select time','preferred time','choose time','select test','test you want','language test','select your slot',];return bad.some(b=>txt===b||txt.includes(b))}
function normalizeTimeTo24(value){const raw=(value||'').trim();if(/^\d{1,2}:\d{2}$/.test(raw)){let[h,m]=raw.split(':').map(Number);return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')}
const m=raw.match(/^(\d{1,2}):(\d{2})\s*(am|pm)$/i);if(m){let h=parseInt(m[1],10);const mins=m[2];const ap=m[3].toLowerCase();if(ap==='pm'&&h<12)h+=12;if(ap==='am'&&h===12)h=0;return String(h).padStart(2,'0')+':'+mins}
return''}
fetch('/wp-json/times/v1/crm-data').then(r=>r.json()).then(res=>{if(!res.success)return;const DATA=res.data;function rebuild(select,list,placeholder){if(select.dataset.rebuilt)return;select.dataset.rebuilt="1";select.innerHTML=`<option value="" disabled selected>${placeholder}</option>`;list.forEach(i=>{select.insertAdjacentHTML('beforeend',`<option value="${i.name}">${i.name}</option>`)});select.value=''}
function initForms(){document.querySelectorAll('form.elementor-form').forEach(form=>{if(form.dataset.crmBound)return;form.dataset.crmBound="1";let citySelect=null;let officeSelect=null;form.querySelectorAll('select').forEach(select=>{if(isCityField(select))citySelect=select;if(isNearestOfficeField(select))officeSelect=select;if(isPreferredCountryField(select))rebuild(select,DATA.desire_country_list,'Preferred Country');if(isStudyLevelField(select))rebuild(select,DATA.qualification_level_list,'Preferred Study Level');if(isFieldOfInterestField(select))rebuild(select,DATA.course_pref_list,'Field of Interest');if(select.options[0]){const firstText=normalize(select.options[0].textContent);if(firstText.includes('select')||firstText.includes('preferred')||firstText.includes('nearest office')||firstText.includes('choose')||firstText.includes('test')){select.options[0].value='';if(select.selectedIndex===0)select.value=''}}
select.addEventListener('change',function(){if(!isPlaceholderValue(select))clearError(select);})});function wireCityOffice(){if(!citySelect||!officeSelect){form.querySelectorAll('select').forEach(s=>{if(isCityField(s))citySelect=s;if(isNearestOfficeField(s))officeSelect=s})}
if(!citySelect||!officeSelect)return;if(form.dataset.cityOfficeWired)return;form.dataset.cityOfficeWired="1";citySelect.innerHTML='<option value="" disabled selected>Select City</option>';Object.keys(DATA.branches).forEach(city=>{citySelect.insertAdjacentHTML('beforeend',`<option value="${city}">${city}</option>`)});citySelect.value='';officeSelect.innerHTML='<option value="" disabled selected>Nearest Office*</option>';officeSelect.disabled=!0;officeSelect.value='';citySelect.addEventListener('change',()=>{form.dataset.selectedCity=citySelect.value;officeSelect.innerHTML='<option value="" disabled selected>Nearest Office*</option>';DATA.branches[citySelect.value]?.forEach(b=>{officeSelect.insertAdjacentHTML('beforeend',`<option value="${b.name}">${b.branch}</option>`)});officeSelect.disabled=!1;officeSelect.value='';if(!isPlaceholderValue(citySelect))clearError(citySelect);clearError(officeSelect)});officeSelect.addEventListener('change',()=>{if(!isPlaceholderValue(officeSelect))clearError(officeSelect);});console.log('✅ City/Office cascade wired for form',form)}
wireCityOffice();if(!form.dataset.cityOfficeWired){const popup=form.closest('.elementor-popup-modal, .dialog-widget, .dialog-message, [data-elementor-type="popup"]');if(popup){const popupObserver=new MutationObserver(()=>{const isVisiblePopup=getComputedStyle(popup).display!=='none'&&getComputedStyle(popup).visibility!=='hidden'&&popup.offsetParent!==null;if(isVisiblePopup){wireCityOffice();if(form.dataset.cityOfficeWired){popupObserver.disconnect()}}});popupObserver.observe(popup,{attributes:!0,attributeFilter:['style','class']});let ancestor=popup.parentElement;while(ancestor&&ancestor!==document.body){popupObserver.observe(ancestor,{attributes:!0,attributeFilter:['style','class']});ancestor=ancestor.parentElement}}}
function handleCRMSubmit(e){if(!e.isTrusted){console.log('⏭️ Ignored non-user-initiated submit/click event for',form);return}
if(window.__crmActiveForm&&window.__crmActiveForm!==form){console.log('⏭️ Another form is already submitting — ignoring this one.',form);return}
const formType=resolveFormType(form);const isGeneric=(formType==='TCO Generic Form');const languageForm=isLanguageForm(formType);const hasEmail=!!form.querySelector('input[type="email"]');const hasPhone=!!form.querySelector('input[type="tel"]');if(isGeneric&&!hasEmail&&!hasPhone){console.log('ℹ️ Generic non-lead form (no email/phone) — allowing default submission');return}
e.preventDefault();e.stopImmediatePropagation();e.stopPropagation();console.log('🧾 FORM SUBMIT DEBUG',{formType,isGeneric,languageForm,form,slug:location.pathname.replace(/^\/|\/$/g,'').toLowerCase()});if(form.dataset.submitting==="1")return;clearAllErrors(form);clearFormNotice(form);const user_data={first_name:'',email:'',phone_mobile:'',country_name:'',degree_level:'',discipline:'',language:'',counseling_mode:'',city:'',securitygroup_id:'',counselling_date:'',counselling_time:'',is_language_form:languageForm,secondary_source:'TCO Contact Us Form',form_type:formType,utm_source:getCRMCookie('utm_source')||'Website',utm_medium:getCRMCookie('utm_medium')||'',utm_campaign_name:getCRMCookie('utm_campaign_name')||'',};let valid=!0;let firstInvalid=null;function flagInvalid(fieldEl,msg){if(!fieldEl)return;valid=!1;showError(fieldEl,msg);if(!firstInvalid)firstInvalid=fieldEl}
const textInputs=Array.from(form.querySelectorAll('input[type="text"]')).filter(i=>{return isVisible(i)&&!i.disabled});const emailInput=Array.from(form.querySelectorAll('input[type="email"]')).find(i=>{return isVisible(i)&&!i.disabled})||null;const phoneInput=Array.from(form.querySelectorAll('input[type="tel"]')).find(i=>{return isVisible(i)&&!i.disabled})||null;const dateInput=Array.from(form.querySelectorAll('input.elementor-date-field, input[type="date"]')).find(i=>{return isVisible(i)&&!i.disabled})||null;const nameInput=textInputs.find(i=>{const t=getFieldText(i);return t.includes('name')||t.includes('full name')})||textInputs[0]||null;if(nameInput&&nameInput.value.trim()){user_data.first_name=nameInput.value.trim()}else if(textInputs.length){for(const i of textInputs){if(i.value.trim()){user_data.first_name=i.value.trim();break}}}
if(emailInput)user_data.email=emailInput.value.trim();if(phoneInput)user_data.phone_mobile=phoneInput.value.trim();if(!languageForm&&dateInput&&dateInput.value.trim()){user_data.counselling_date=dateInput.value.trim()}
let modeSelect=null;let timeSelect=null;let countrySelect=null;let levelSelect=null;let fieldSelect=null;let languageSelect=null;let citySelectFound=null;let officeSelectFound=null;form.querySelectorAll('select').forEach(s=>{const isOffice=isNearestOfficeField(s);if(!isVisible(s)&&!isOffice)return;if(s.disabled&&!isOffice)return;if(isPreferredCountryField(s))countrySelect=s;if(isStudyLevelField(s))levelSelect=s;if(isFieldOfInterestField(s))fieldSelect=s;if(isLanguageTestField(s))languageSelect=s;if(isPreferredModeField(s))modeSelect=s;if(isTimeField(s))timeSelect=s;if(isCityField(s))citySelectFound=s;if(isOffice)officeSelectFound=s});console.log('🔎 FIELD DETECTION DEBUG',{nameInput,emailInput,phoneInput,dateInput,countrySelect,levelSelect,fieldSelect,languageSelect,modeSelect,timeSelect,citySelectFound,officeSelectFound});if(countrySelect&&!isPlaceholderValue(countrySelect)){user_data.country_name=countrySelect.value.trim()}
if(levelSelect&&!isPlaceholderValue(levelSelect)){user_data.degree_level=levelSelect.value.trim()}
if(fieldSelect&&!isPlaceholderValue(fieldSelect)){user_data.discipline=fieldSelect.value.trim()}
if(languageSelect&&!isPlaceholderValue(languageSelect)){user_data.language=languageSelect.value.trim()}
if(modeSelect&&!isPlaceholderValue(modeSelect)){user_data.counseling_mode=modeSelect.value.trim()}
if(citySelectFound&&!isPlaceholderValue(citySelectFound)){user_data.city=citySelectFound.value.trim()}
if(officeSelectFound&&!isPlaceholderValue(officeSelectFound)){user_data.securitygroup_id=officeSelectFound.value.trim()}
if(timeSelect&&!isPlaceholderValue(timeSelect)){const normalizedTime=normalizeTimeTo24(timeSelect.value.trim());if(normalizedTime){user_data.counselling_time=normalizedTime}else{user_data.counselling_time=timeSelect.value.trim()}}
console.log('📦 PRE-VALIDATION PAYLOAD',user_data);if(nameInput&&!user_data.first_name){flagInvalid(nameInput,'Please enter your name')}
if(emailInput&&!user_data.email){flagInvalid(emailInput,'Please enter your email')}else if(emailInput&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(user_data.email)){flagInvalid(emailInput,'Please enter a valid email address')}
if(phoneInput&&!user_data.phone_mobile){flagInvalid(phoneInput,'Please enter your phone number')}
if(languageForm){if(languageSelect&&!user_data.language){flagInvalid(languageSelect,'Please select a language test')}
if(modeSelect&&!user_data.counseling_mode){flagInvalid(modeSelect,'Please select a preferred mode of counselling')}
if(citySelectFound&&!user_data.city){flagInvalid(citySelectFound,'Please select a city')}
if(officeSelectFound&&user_data.city&&!user_data.securitygroup_id){flagInvalid(officeSelectFound,'Please select a nearest office')}}else if(!isGeneric){if(countrySelect&&!user_data.country_name)flagInvalid(countrySelect,'Please select a preferred country');if(levelSelect&&!user_data.degree_level)flagInvalid(levelSelect,'Please select a study level');if(fieldSelect&&!user_data.discipline)flagInvalid(fieldSelect,'Please select a field of interest');if(modeSelect&&!user_data.counseling_mode)flagInvalid(modeSelect,'Please select a preferred mode of counselling');if(dateInput&&!user_data.counselling_date)flagInvalid(dateInput,'Please select a counselling date');if(timeSelect&&!user_data.counselling_time)flagInvalid(timeSelect,'Please select a counselling time');if(citySelectFound&&!user_data.city)flagInvalid(citySelectFound,'Please select a city');if(officeSelectFound&&user_data.city&&!user_data.securitygroup_id)flagInvalid(officeSelectFound,'Please select a nearest office');}
if(!valid){console.warn('❌ Validation failed — CRM not called');if(firstInvalid){firstInvalid.scrollIntoView({behavior:'smooth',block:'center'});firstInvalid.focus()}
return}
const UTM_KEYS=['utm_source','utm_medium','utm_campaign_name'];Object.keys(user_data).forEach(key=>{if(UTM_KEYS.includes(key))return;if(user_data[key]===''||user_data[key]===null||typeof user_data[key]==='undefined'){delete user_data[key]}});console.log('✅ CRM Payload',user_data);form.dataset.submitting="1";window.__crmActiveForm=form;const submitBtn=form.querySelector('[type="submit"]');if(submitBtn){submitBtn.disabled=!0;submitBtn.dataset.crmOrigText=submitBtn.textContent;submitBtn.textContent='Please wait…'}
