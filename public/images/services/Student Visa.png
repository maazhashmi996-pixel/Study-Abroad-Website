function showError(field,msg){field.classList.add('crm-field-error');const existing=field.parentNode.querySelector('.crm-error-msg');if(existing)existing.remove();const span=document.createElement('span');span.className='crm-error-msg';span.textContent=msg;field.parentNode.appendChild(span)}
function clearError(field){field.classList.remove('crm-field-error');const existing=field.parentNode.querySelector('.crm-error-msg');if(existing)existing.remove();}
function clearAllErrors(form){form.querySelectorAll('.crm-field-error').forEach(f=>f.classList.remove('crm-field-error'));form.querySelectorAll('.crm-error-msg').forEach(el=>el.remove())}
document.addEventListener('input',function(e){if(e.target.classList.contains('crm-field-error'))clearError(e.target);});document.addEventListener('change',function(e){if(e.target.classList.contains('crm-field-error'))clearError(e.target);});document.addEventListener('click',function(e){const btn=e.target.closest('button[type="submit"]');if(!btn)return;const form=btn.closest('form.elementor-form');if(!form)return;const formIdInput=form.querySelector('input[name="form_id"]');if(!formIdInput||formIdInput.value!==TARGET_FORM_ID)return;console.log('🟡 Target form button clicked (5aa022f3)');e.preventDefault();e.stopImmediatePropagation();clearAllErrors(form);const formData=new FormData(form);const user_data={first_name:'',email:'',phone_mobile:'',country_name:'',degree_level:'',counseling_mode:'',city:'',securitygroup_id:'',secondary_source:'TCO Contact Us Form',form_type:'TCO Homepage form',utm_source:getCRMCookie('utm_source')||'Website',utm_medium:getCRMCookie('utm_medium')||'',utm_campaign_name:getCRMCookie('utm_campaign_name')||'',};formData.forEach((value,key)=>{if(key==='form_fields[name]')user_data.first_name=value.trim();if(key==='form_fields[email]')user_data.email=value.trim();if(key==='form_fields[field_272e6da]')user_data.phone_mobile=value.trim();});form.querySelectorAll('select').forEach(select=>{const group=select.closest('.elementor-field-group');const label=normalize(group?.querySelector('label')?.innerText);if(label.includes('study destination')){user_data.country_name=select.value||''}else if(label.includes('study level')){user_data.degree_level=select.value||''}else if(label.includes('counselling')){user_data.counseling_mode=select.value||''}else if(label.includes('nearest')){user_data.securitygroup_id=(select.value&&select.value!=='__change_city__')?select.value:'';user_data.city=form.dataset.selectedCity||''}});console.log('🟣 Collected user_data:',user_data);let valid=!0;let firstInvalid=null;function flagInvalid(fieldEl,msg){valid=!1;showError(fieldEl,msg);if(!firstInvalid)firstInvalid=fieldEl}
const nameInput=form.querySelector('input[name="form_fields[name]"]');if(nameInput&&!user_data.first_name){flagInvalid(nameInput,'Please enter your name')}
const emailInput=form.querySelector('input[name="form_fields[email]"]');if(emailInput){if(!user_data.email){flagInvalid(emailInput,'Please enter your email')}else if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(user_data.email)){flagInvalid(emailInput,'Please enter a valid email address')}}
const phoneInput=form.querySelector('input[name="form_fields[field_272e6da]"]');if(phoneInput&&!user_data.phone_mobile){flagInvalid(phoneInput,'Please enter your phone number')}
form.querySelectorAll('select').forEach(select=>{const group=select.closest('.elementor-field-group');const label=normalize(group?.querySelector('label')?.innerText);if(label.includes('study destination')&&!user_data.country_name){flagInvalid(select,'Please select a study destination')}else if(label.includes('study level')&&!user_data.degree_level){flagInvalid(select,'Please select a study level')}else if(label.includes('counselling')&&!user_data.counseling_mode){flagInvalid(select,'Please select a counselling mode')}else if(label.includes('nearest')){if(!user_data.securitygroup_id){flagInvalid(select,'Please select your nearest branch')}}});if(!valid){console.warn('❌ Validation failed — CRM not called');if(firstInvalid)firstInvalid.scrollIntoView({behavior:'smooth',block:'center'});return}
if(form.dataset.submitting==="1")return;form.dataset.submitting="1";const crm_payload={first_name:user_data.first_name,email:user_data.email,phone_mobile:user_data.phone_mobile,country_name:user_data.country_name,degree_level:user_data.degree_level,counseling_mode:user_data.counseling_mode,city:user_data.city,securitygroup_id:user_data.securitygroup_id,secondary_source:user_data.secondary_source,form_type:user_data.form_type,utm_source:user_data.utm_source,utm_medium:user_data.utm_medium,utm_campaign_name:user_data.utm_campaign_name,};console.log('🟣 Final CRM Payload:',crm_payload);fetch('/wp-json/times/v1/cta-lead',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({user_data:crm_payload})}).then(r=>r.json()).then(res=>{if(res.success){console.log('✅ Lead sent to CRM');window.location.href=THANK_YOU_URL}else{console.error('❌ CRM rejected lead',res);form.dataset.submitting="0"}}).catch(err=>{console.error('❌ Network error',err);form.dataset.submitting="0"})},!0)})()</script> <script>(function(){if(location.pathname.endsWith('/times/'))return;const normalize=s=>(s||'').toLowerCase().replace(/\*/g,'').trim();const THANK_YOU_URL='https://timesconsultant.com/thank-you';function isVisible(el){if(!el)return!1;const style=getComputedStyle(el);if(style.display==='none'||style.visibility==='hidden')return!1;return el.getClientRects().length>0}
function setCRMCookie(name,value,seconds){const expires=new Date(Date.now()+seconds*1000).toUTCString();document.cookie=`${name}=${encodeURIComponent(value)};expires=${expires};path=/;SameSite=Lax`}
function getCRMCookie(name){const match=document.cookie.match(new RegExp('(?:^|; )'+name+'=([^;]*)'));return match?decodeURIComponent(match[1]):null}
function captureUTMs(){const params=new URLSearchParams(window.location.search);const expiry=2*24*60*60;const utmKeys=['utm_source','utm_medium','utm_campaign_name',];utmKeys.forEach(function(key){const val=params.get(key);if(val)setCRMCookie(key,val,expiry);})}
captureUTMs();(function(){if(getCRMCookie('cookie_consent'))return;const banner=document.createElement('div');banner.id='crm-cookie-banner';banner.style.cssText=['position:fixed','bottom:0','left:0','right:0','z-index:999999','background:#1a1a1a','color:#fff','padding:14px 24px','display:flex','align-items:center','justify-content:space-between','flex-wrap:wrap','gap:10px','font-size:14px','line-height:1.5','box-shadow:0 -2px 12px rgba(0,0,0,0.3)',].join(';');banner.innerHTML=`
            <span style="flex:1;min-width:200px;">
                We use cookies to improve your experience and track campaign performance.
                <a href="/privacy-policy" style="color:#90c8f0;margin-left:6px;text-decoration:underline;">Learn more</a>
            </span>
            <div style="display:flex;gap:10px;flex-shrink:0;">
                <button id="cookie-decline" style="
                    background:transparent;border:1px solid #888;color:#ccc;
                    padding:7px 18px;border-radius:5px;font-size:13px;
                ">Decline</button>
                <button id="cookie-accept" style="
                    background:#0073aa;border:none;color:#fff;
                    padding:7px 18px;border-radius:5px;font-size:13px;
                ">Accept Cookies</button>
