function renderUniPortal(q){uniPortal.innerHTML='';if(!universitiesLoaded){uniPortal.innerHTML='<div style="padding:16px;text-align:center;color:#666;font-size:13px;">Loading universities...</div>';uniPortal.style.display='block';positionPortal(uniInput,uniPortal,8);return}
const Q=(q||'').toLowerCase().trim();const matches=universities.filter(u=>{const name=(u.name||'').toLowerCase();const city=(u.city||'').toLowerCase();const country=(u.country||'').toLowerCase();const region=(u.region||'').toLowerCase();const state=(u.state||'').toLowerCase();return name.includes(Q)||city.includes(Q)||country.includes(Q)||region.includes(Q)||state.includes(Q)}).slice(0,50);if(!matches.length){uniPortal.innerHTML='<div style="padding:16px;text-align:center;color:#666;font-size:13px;">No universities found</div>';uniPortal.style.display='block';positionPortal(uniInput,uniPortal,8);return}
