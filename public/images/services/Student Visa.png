ntListener('change',function(){const checked=this.checked;const g=groups[pid];g.items.forEach(it=>{it.elCheckbox.checked=checked;if(checked)selected[it.id]={id:it.id,name:it.name,parentId:pid,parentName:group.name};else delete selected[it.id]});g.selectedAllByParent=checked;g.elParentCheckbox.indeterminate=!1;updateDegreeParentState(pid)});degreeDropdown.appendChild(parentRow);degreeDropdown.appendChild(children)});renderDegreeChips()}).catch(err=>{console.warn('degree fetch error',err);degreeDropdown.innerHTML='<div style="padding:8px;color:#888">Qualifications unavailable</div>'});const existingLocWrapper=Array.from(row.children).find(ch=>ch.querySelector&&ch.querySelector('.tcf-loc-select'));const locWrap=createEl('div',{class:'tcf-field-wrap tcf-degree-wrap tcf-loc-wrap'});locWrap.innerHTML=`
