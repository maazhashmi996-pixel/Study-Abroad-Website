row.style.padding='10px';row.style.cursor='pointer';row.style.borderBottom='1px solid rgba(0,0,0,0.04)';row.addEventListener('click',()=>{uniInput.value=u.name;uniInput.dataset.slug=u.slug||'';uniPortal.style.display='none'});row.addEventListener('mouseenter',()=>row.style.background='#f4f6ff');row.addEventListener('mouseleave',()=>row.style.background='transparent');uniPortal.appendChild(row)});positionPortal(uniInput,uniPortal,8);uniPortal.style.display='block'}
