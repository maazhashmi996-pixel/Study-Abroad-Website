function ensureArray(resp){if(!resp)return[];if(Array.isArray(resp))return resp;if(resp.results&&Array.isArray(resp.results))return resp.results;if(Array.isArray(resp.data))return resp.data;if(Array.isArray(resp.institutes))return resp.institutes;for(const k in resp)if(Array.isArray(resp[k]))return resp[k];return[]}
